[Sources]
  WinRtSmpDxe.c
[Sources.ARM]
  Arm/Parking.S
[Packages]
  MdePkg/MdePkg.dec
  ArmPkg/ArmPkg.dec
  ArmVirtPkg/ArmVirtPkg.dec
  ArmVirtPkg/ArmVirtQemuWinRtPkg.dec
[LibraryClasses]
  UefiDriverEntryPoint
  UefiBootServicesTableLib
  UefiLib
  BaseLib
  BaseMemoryLib
  MemoryAllocationLib
  CacheMaintenanceLib
