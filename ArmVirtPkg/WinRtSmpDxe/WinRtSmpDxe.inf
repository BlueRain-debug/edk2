[Defines]
  INF_VERSION = 1.29
  BASE_NAME = WinRtSmpDxe
  FILE_GUID = 2e7cfb2e-d9c6-422d-b680-2f80abe6687c
  MODULE_TYPE = DXE_DRIVER
